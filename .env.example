# Copy to .env and edit. Never commit .env.
ENVIRONMENT=dev

# Postgres (docker compose service "db")
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=reliability
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reliability

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM: any OpenAI-compatible endpoint.
# Option A: OmniRoute running on your machine (default port 20128). Keep it on localhost.
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=paste-your-omniroute-key-here
LLM_MODEL=auto
# Option B: Ollama. LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama  LLM_MODEL=qwen2.5:7b

# Auth. Generate a real secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-dev
